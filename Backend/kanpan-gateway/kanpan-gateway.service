[Unit]
Description=Kanpan historical OI cache
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/kanpan-gateway
ExecStart=/usr/bin/python3 /opt/kanpan-gateway/server.py
EnvironmentFile=-/etc/kanpan-gateway/limits.env
Environment=PORT=8792
CacheDirectory=kanpan-gateway
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Sized for the 7-core / 8 GB primary. Fewer than ten people share this host,
# so the budget exists only to stop a runaway process, not to ration service.
# The 3-core / 4 GB standby halves it via kanpan-gateway.service.d/.
MemoryMax=1G
CPUQuota=300%
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
