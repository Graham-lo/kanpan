[Unit]
Description=Kanpan shared public market subscriptions
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/kanpan-gateway
ExecStart=/opt/kanpan-gateway/venv/bin/python /opt/kanpan-gateway/stream_hub.py
EnvironmentFile=-/etc/kanpan-gateway/limits.env
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Primary node budget; the standby halves it via kanpan-stream-hub.service.d/.
MemoryMax=1G
CPUQuota=300%
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
