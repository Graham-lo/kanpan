{
 "version": 1,
 "whatThisIs": "提醒判定的共用夹具：一根 K 线对一条提醒响不响、响在哪条线的哪个价。客户端 AlertEvaluator.hit 与服务端 alerts.rs 的 judge 各跑一遍，结论必须一字不差。",
 "howToMaintain": "手工维护。改判定规则时先在这里加 / 改用例，两边的测试（KanpanCore AlertCasesContractTests、Rust alerts::tests::every_shared_alert_case_agrees）会各自告诉你哪一边还没跟上。时间是毫秒整数，价格是有限数。",
 "fields": "condition: touch | close；armedAt 毫秒；lines 与同步线上的 alerts.lines 同形；bar.openTime/low/high 必有，close/previousClose 可缺（缺 previousClose 就是「没有上一根」），closed 是币安 kline 的 k.x；expect 为 null 表示不响，否则 {line: alert.lines 下标, price: 线在这一刻的价}。服务端只返回价，line 下标只有客户端核对。",
 "cases": [
  {
   "name": "touch-inside",
   "why": "最低 ≤ 线价 ≤ 最高",
   "condition": "touch",
   "armedAt": 0,
   "lines": [
    {
     "points": [
      {
       "t": 1000,
       "p": 100
      }
     ],
     "extendLeft": true,
     "extendRight": true
    }
   ],
   "bar": {
    "openTime": 1050,
    "low": 99,
    "high": 101,
    "closed": false
   },
   "expect": {
    "line": 0,
    "price": 100
   }
  },
