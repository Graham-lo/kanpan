        </RelativeLayout>
        <RelativeLayout android:id="@id/container_vip_my_formula" android:clickable="true" android:layout_width="match_parent" android:layout_height="@dimen/sh_base_settings_item_block_height" style="@style/sh_base.Settings.ItemContainer">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_kline_spread_charts_home_my_formula" android:layout_centerVertical="true" style="@style/sh_base.Settings.ItemTitle" />
            <ImageView android:tag="skin:sh_base_ic_expand:src" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@mipmap/sh_base_ic_expand" android:layout_alignParentRight="true" android:layout_centerVertical="true" android:contentDescription="@string/widget_action_more_description" android:layout_alignParentEnd="true" />
        </RelativeLayout>
